# Cloudflare Pages 缓存策略
# 入口页禁止缓存：推送新版本后立即生效，避免边缘节点持有旧版 index.html。
/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
# 无哈希的静态文件也禁缓存
/theme-init.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/theme-init.css
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
# 哈希命名的构建产物可永久缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable
