# Workers Static Assets 的 _headers 规则
# 入口页禁止缓存：避免浏览器/wrangler dev 持有旧版 index.html，
# 引用已删除的旧资源导致白屏。哈希命名的构建产物可永久缓存。
/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/assets/*
  Cache-Control: public, max-age=31536000, immutable
