name = "mailfree"
main = "src/server.js"
compatibility_date = "2024-01-01"
keep_vars = true

# D1 数据库绑定
[[d1_databases]]
binding = "TEMP_MAIL_DB"
database_name = "maill_free_db" # 你的 d1 数据库名称
database_id = "your-d1-database-id" # 你的 database_id

# 环境变量（请替换为你的真实值，切勿提交真实凭证到仓库）
[vars]
# FORWARD_RULES='[{"prefix":"vip","email":"a@example.com"},{"prefix":"*","email":"example@qq.com"}]'
ADMIN_NAME = "admin"
ADMIN_PASSWORD = "your-admin-password"
GUEST_PASSWORD = "your-guest-password"
JWT_TOKEN = "your-jwt-secret"
SESSION_EXPIRE_DAYS = "7"
MAIL_DOMAIN = "example.com"
RESEND_API_KEY = "re_your_resend_api_key"

# 静态资源目录（Workers + Assets）
[assets]
directory = "public"
# 显式指定绑定名，确保在 Worker 中通过 env.ASSETS 可用
binding = "ASSETS"

# R2 存储桶绑定（用于保存完整 EML 内容）
[[r2_buckets]]
binding = "MAIL_EML"
bucket_name = "mail-eml"

# wrangler.toml (wrangler v3.88.0^) 日志服务
# [observability.logs]
# enabled = true
